# Copy to `.env.local` and add a credential to enable the real model:
#   cp .env.example .env.local
#
# With NO credential, the app automatically falls back to the mock model, so it still
# runs end to end at zero cost. Never commit real keys — `.env.local` is git-ignored.

# ── Preferred: Vercel AI Gateway ─────────────────────────────────────────────
# One credential routes every provider (OpenAI / Google / Anthropic) via
# "provider/model" strings — no provider-specific SDK key required.
# Create a key at https://vercel.com/dashboard (AI Gateway → API keys).
# On Vercel deployments this is unnecessary: a VERCEL_OIDC_TOKEN is auto-injected.
AI_GATEWAY_API_KEY=

# ── Fallback: provider keys (only if you are NOT using the gateway) ───────────
# Set just the one(s) you have; each enables that provider's models directly.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
